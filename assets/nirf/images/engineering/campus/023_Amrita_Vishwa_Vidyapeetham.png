        <p class="am:text-[#262626] am:text-left am:font-satoshi am:mt-8 am:max-w-4xl am:mb-6 am:text-sm am:sm:text-base am:font-satoshi am:leading-relaxed">
            </p>
        <a href="https://www.amrita.edu/life-at-amrita/" class="am:relative am:bg-primary am:font-satoshi am:text-[#AF0C3E] am:rounded-md am:inline-flex am:items-center am:gap-3 am:py-2 am:hover:opacity-90 am:transition am:group">
                        <img decoding="async" src="https://www.amrita.edu/wp-content/themes/amrita/new-amrita/assets/icons/arrow-icon-colored.svg" alt="Arrow" class="am:w-3 am:h-3" />
