            <div
              class="am:absolute am:inset-0 am:bg-blue-500/20 am:rounded-full am:blur-2xl am:opacity-0 am:group-focus-within:opacity-100 am:transition-all am:duration-500">
            </div>

            <div id="search-input-wrapper"
              class="am:relative am:flex am:items-center am:h-18 am:bg-white/5 am:backdrop-blur-3xl am:border am:border-white/10 am:rounded-full am:shadow-2xl am:ring-1 am:ring-white/10 focus-within:am:ring-white/40 am:transition-all am:overflow-hidden am:w-full">

