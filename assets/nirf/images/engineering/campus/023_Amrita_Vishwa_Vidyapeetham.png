                                    <div class="am:w-full am:h-24 am:mb-4 am:flex am:items-center am:justify-center">
                                        <img decoding="async" src="https://webfiles.amrita.edu/2025/12/Chennai-1.png" alt="Chennai Campus" class="am:h-full am:object-contain" />
