                        <div class="am:relative">
                        <select id="mobile-filter-select" onchange="handleMobileSelect(this)" class="mobile-filter-select am:appearance-none am:bg-white/10 am:border am:border-white/10 am:rounded-full am:py-3.5 am:pl-4 am:pr-10 am:mr-2 am:text-xs am:font-bold am:uppercase am:tracking-wider am:text-white am:outline-none am:focus:ring-2 am:focus:ring-white/20">
