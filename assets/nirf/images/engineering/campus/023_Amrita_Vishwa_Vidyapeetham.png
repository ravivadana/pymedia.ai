<a href="https://www.amrita.edu/program/bharatiya-jnana-parampara/" class="am:block am:py-4 am:border-b am:border-gray-50 am:text-gray-700 am:hover:text-[#AF0C3E] am:font-satoshi">Bhāratīya Jñāna Paramparā</a><a href="https://www.amrita.edu/program/digvijaya/" class="am:block am:py-4 am:border-b am:border-gray-50 am:text-gray-700 am:hover:text-[#AF0C3E] am:font-satoshi">DigVijaya</a><a href="https://www.amrita.edu/program/essence-of-hinduism/" class="am:block am:py-4 am:border-b am:border-gray-50 am:text-gray-700 am:hover:text-[#AF0C3E] am:font-satoshi">Essence Of Hinduism</a><a href="https://www.amrita.edu/program/online-meditation-course-in-mastery-over-mind/" class="am:block am:py-4 am:border-b am:border-gray-50 am:text-gray-700 am:hover:text-[#AF0C3E] am:font-satoshi">Online Meditation Course in Mastery Over Mind</a><a href="https://www.amrita.edu/program/open-courses/" class="am:block am:py-4 am:border-b am:border-gray-50 am:text-gray-700 am:hover:text-[#AF0C3E] am:font-satoshi">Open Courses</a><a href="https://www.amrita.edu/program/rigvedic-geography/" class="am:block am:py-4 am:border-b am:border-gray-50 am:text-gray-700 am:hover:text-[#AF0C3E] am:font-satoshi">Rigvedic Geography</a></div><div id="m-view-academics-certificate-social-behavioural-sciences" class="am:mobile-view am:absolute am:inset-0 am:translate-x-full am:flex am:flex-col am:bg-white am:overflow-y-auto am:p-4 am:transition-transform am:duration-300"><a href="https://www.amrita.edu/program/post-graduate-diploma-in-counselling-psychology/" class="am:block am:py-4 am:border-b am:border-gray-50 am:text-gray-700 am:hover:text-[#AF0C3E] am:font-satoshi">One year Post Graduate Diploma in Counselling Psychology</a></div><div id="m-view-academics-online-programs-certificate-programs-and-degree-programs" class="am:mobile-view am:absolute am:inset-0 am:translate-x-full am:flex am:flex-col am:bg-white am:overflow-y-auto am:p-4 am:transition-transform am:duration-300"><a href="https://onlineamrita.com/" class="am:block am:py-4 am:border-b am:border-gray-50 am:text-gray-700 am:hover:text-[#AF0C3E] am:font-satoshi">View More</a></div><div id="m-view-academics-curriculum-academics" class="am:mobile-view am:absolute am:inset-0 am:translate-x-full am:flex am:flex-col am:bg-white am:overflow-y-auto am:p-4 am:transition-transform am:duration-300"><a href="https://www.amrita.edu/academics/curriculum" class="am:block am:py-4 am:border-b am:border-gray-50 am:text-gray-700 am:hover:text-[#AF0C3E] am:font-satoshi">View More</a></div>                        <div id="m-view-campus" class="am:mobile-view am:absolute am:inset-0 am:translate-x-full am:flex am:flex-col am:bg-white am:overflow-y-auto am:p-4 am:pb-24 am:transition-transform am:duration-300">
                            <div class="am:grid am:grid-cols-1 am:gap-4">
                                <a href="https://www.amrita.edu/campus/amaravati/" class="am:group am:block am:relative am:p-5 am:h-full am:transition-all am:duration-300 am:hover:shadow-lg" style="background-color: #fffbf0;">
