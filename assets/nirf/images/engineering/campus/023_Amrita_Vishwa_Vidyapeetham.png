            <section id="events" class="am:py-15 am:lg:py-25 am:bg-black am:relative am:overflow-hidden sticky-header-invert">
            <div class="am:container am:mx-auto am:px-4 am:relative am:z-10">
                <p class="am:text-left am:font-satoshi am:mb-2 am:text-gray-400"></p>
                <h2 class="am:text-white am:leading-tight am:text-4xl am:sm:text-5xl am:lg:text-6xl am:font-medium am:uppercase am:text-left am:font-anton am:mb-10">Upcoming Events</h2>
                <div class="swiper am:UpcomingEvents am:!overflow-hidden">
                <div class="swiper-wrapper">
                    <div class="swiper-slide am:h-auto am:font-satoshi">
